class GameSprite(sprite.Sprite):
    def __init__(self, player_image, player_x, player_y, player_speed, wight, height):
        super().__init__()
        self.image = transform.scale(image.load(player_image), (wight, height))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y
    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update(self):
        keys_pressed = key.get_pressed()
        if keys_pressed[K_LEFT] and self.rect.x > 5:
            self.rect.x -= self.speed
        if keys_pressed[K_RIGHT] and self.rect.x < 595:
            self.rect.x += self.speed
    def fire(self):
        NewBullet = Bullet('png-klev-club-6xp3-p-raketa-voennaya-png-5-no-bg-preview (carve.photos).png', self.rect.centerx, self.rect.top, 15, 50, 50)
        bullets.add(NewBullet)

lost = 0
class Enemy(GameSprite):
    def update(self):
        global lost
        self.rect.y += self.speed
        if self.rect.y > razmer2:
            self.rect.x = random.randint(80, razmer1 - 80)
            self.rect.y = 0
            lost = lost + 1

bulletstime = 0   
kills = 0
class Bullet(GameSprite):
    def update(self):
        global bulletstime
        self.rect.y -= self.speed
        if self.rect.y < 0:
            proigral.play()
            self.kill()


class Kamikads(GameSprite):
    def update(self):
        self.rect.y += self.speed
        if self.rect.y > razmer2:
            self.rect.x = random.randint(80, razmer1 - 80)
            self.rect.y = 0
        
        

